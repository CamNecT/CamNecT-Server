# Merge into the existing .env.prod or .env.stage; never replace the full file.
# Keep both flags false until the provider and frontend are ready.
PHONE_SMS_PROVIDER=solapi
PHONE_ROLLOUT_MODE=legacy
PHONE_VERIFICATION_ENABLED=false
PHONE_FRONTEND_READY=false
# Explicit operator approval only: older clients may fail signup/purchase.
PHONE_ALLOW_PENDING_FRONTEND=false
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
PHONE_SMS_SENDER_NUMBER=
PHONE_VERIFICATION_CODE_SECRET=
PHONE_SMS_DAILY_LIMIT=20
PHONE_SMS_MONTHLY_LIMIT=50
